{
  "name": "we-culture-automation-test",
  "version": "1.0.0",
  "description": "Tests automatisés avec Cypress et Allure Report",
  "main": "index.js",
  "devDependencies": {
    "allure-commandline": "^2.24.0",
    "allure-cypress": "^3.7.2",
    "cypress": "^14.3.1",
    "cypress-plugin-stripe-elements": "^1.0.2"
  },
  "scripts": {
    "cypress:open": "node scripts/run-cypress.js open",
    "cypress:run": "node scripts/run-cypress.js run --browser chrome",
    "cypress:run:headed": "node scripts/run-cypress.js run --browser chrome --headed",
    "allure:clear": "node scripts/clean-allure.js",
    "allure:report": "node scripts/run-allure.js generate allure-results --clean -o allure-report",
    "allure:generate": "npm run allure:report",
    "allure:serve": "node scripts/run-allure.js serve allure-results",
    "pretest": "npm run allure:clear",
    "test": "npm run cypress:run",
    "posttest": "npm run allure:report",
    "cypress:run-and-report": "npm run pretest && npm run test && npm run posttest"
  },
  "keywords": [
    "cypress",
    "testing",
    "automation",
    "allure"
  ],
  "author": "",
  "license": "ISC"
}
